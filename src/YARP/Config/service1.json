{
  "ReverseProxy": {
    "Routes": {
      "service-one": { 
        "ClusterId": "service1-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": { 
          "Path": "/api/one/{**catch-all}"
        },
        "Transforms": [
          {"PathRemovePrefix": "/api/one"}
        ]
      }
    },
    "Clusters": {
      "service1-cluster": {
        "HttpClient": {
          "ActivityTimeout": "00:00:30"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        },
        "Destinations": { 
          "d1": { 
            "Address": "https://httpbin.org/"
          }
        }
      }
    }
  }
}